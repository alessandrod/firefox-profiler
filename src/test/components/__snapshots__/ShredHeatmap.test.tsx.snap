exports[`ShredHeatmap renders the synthetic shred heatmap 1`] = `
<div
  aria-labelledby="shred-heatmap-tab-button"
  class="shredHeatmap"
  id="shred-heatmap-tab"
  role="tabpanel"
>
  <div
    aria-label="Shred heatmap legend"
    class="shredHeatmapLegend"
  >
    <span
      class="shredHeatmapLegendTitle"
    >
      Turbine layers
    </span>
    <button
      aria-pressed="false"
      class="shredHeatmapLegendItem shredHeatmapLegendButton"
      data-active="false"
      data-layer="root"
      type="button"
    >
      <span
        aria-hidden="true"
        class="shredHeatmapLegendSwatch shredHeatmapLegendSwatchRoot"
      />
      <span>
        Root
      </span>
    </button>
    <button
      aria-pressed="false"
      class="shredHeatmapLegendItem shredHeatmapLegendButton"
      data-active="false"
      data-layer="l1"
      type="button"
    >
      <span
        aria-hidden="true"
        class="shredHeatmapLegendSwatch shredHeatmapLegendSwatchL1"
      />
      <span>
        L1
      </span>
    </button>
    <button
      aria-pressed="false"
      class="shredHeatmapLegendItem shredHeatmapLegendButton"
      data-active="false"
      data-layer="l2"
      type="button"
    >
      <span
        aria-hidden="true"
        class="shredHeatmapLegendSwatch shredHeatmapLegendSwatchL2"
      />
      <span>
        L2
      </span>
    </button>
    <button
      aria-pressed="false"
      class="shredHeatmapLegendItem shredHeatmapLegendButton"
      data-active="false"
      data-layer="l3"
      type="button"
    >
      <span
        aria-hidden="true"
        class="shredHeatmapLegendSwatch shredHeatmapLegendSwatchL3"
      />
      <span>
        L3
      </span>
    </button>
    <button
      aria-pressed="false"
      class="shredHeatmapLegendItem shredHeatmapLegendButton"
      data-active="false"
      data-layer="recovered"
      type="button"
    >
      <span
        aria-hidden="true"
        class="shredHeatmapLegendSwatch shredHeatmapLegendSwatchRecovered"
      />
      <span>
        Recovered
      </span>
    </button>
    <button
      aria-pressed="false"
      class="shredHeatmapLegendItem shredHeatmapLegendButton"
      data-active="false"
      data-layer="repair"
      type="button"
    >
      <span
        aria-hidden="true"
        class="shredHeatmapLegendSwatch shredHeatmapLegendSwatchRepair"
      />
      <span>
        Repaired
      </span>
    </button>
    <span
      class="shredHeatmapLegendTitle"
    >
      Shreds
    </span>
    <button
      aria-pressed="false"
      class="shredHeatmapLegendItem shredHeatmapLegendButton"
      data-active="false"
      data-kind="data"
      type="button"
    >
      <span
        aria-hidden="true"
        class="shredHeatmapLegendShape shredHeatmapLegendShapeData"
      />
      <span>
        Data
      </span>
    </button>
    <button
      aria-pressed="false"
      class="shredHeatmapLegendItem shredHeatmapLegendButton"
      data-active="false"
      data-kind="code"
      type="button"
    >
      <span
        aria-hidden="true"
        class="shredHeatmapLegendShape shredHeatmapLegendShapeCode"
      />
      <span>
        Coding
      </span>
    </button>
  </div>
  <div
    class="shredHeatmapViewport"
    style="height: 320px;"
  >
    <canvas
      class="shredHeatmapCanvas"
      height="168"
      width="480"
    />
  </div>
</div>
`;
